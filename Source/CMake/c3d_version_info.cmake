macro(c3d_version_define is_math_library)
  set(_C3D_FD "\"@pl@-bit @gen@ @symb@ @bt@@opts@\"")

  if(MathTest_BUILD_ID)
    string(REGEX MATCH "[-][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]"  _C3D_PRIVATE_STRING ${MathTest_BUILD_ID})
  else()
    message(STATUS "MathTest_BUILD_ID is not defined")
  endif()

  if(PROJECT_VERSION)
    message(STATUS "Project version is ${PROJECT_VERSION}")
  else()
    set(PROJECT_VERSION_MAJOR 0)
    set(PROJECT_VERSION_MINOR 0)
    set(PROJECT_VERSION_PATCH 0)
    set(PROJECT_VERSION_TWEAK 0)
    set(PROJECT_VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}.${PROJECT_VERSION_TWEAK})
    message(STATUS "Project version was configured to ${PROJECT_VERSION}")
  endif()
  set(_C3D_PV "\"${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}\"" )
  set(_C3D_FV "\"${PROJECT_VERSION}${_C3D_PRIVATE_STRING}\"" )
  add_definitions( -DBI_FILEVERSION_MAJOR=${PROJECT_VERSION_MAJOR})
  add_definitions( -DBI_PRODUCTVERSION_MAJOR=${PROJECT_VERSION_MAJOR})
  add_definitions( -DBI_FILEVERSION_MINOR=${PROJECT_VERSION_MINOR})
  add_definitions( -DBI_PRODUCTVERSION_MINOR=${PROJECT_VERSION_MINOR})
  add_definitions( -DBI_FILEVERSION_BUILD=${PROJECT_VERSION_PATCH})
  add_definitions( -DBI_PRODUCTVERSION_BUILD=${PROJECT_VERSION_PATCH})
  add_definitions( -DBI_FILEVERSION_REVISION=${PROJECT_VERSION_TWEAK})
  add_definitions( -DBI_PRODUCTVERSION_REVISION=${PROJECT_VERSION_TWEAK})
  add_definitions( -DBI_PRODUCTVERSION=${_C3D_PV} )
  add_definitions( -DBI_FILEVERSION=${_C3D_FV} )
  if(_C3D_PRIVATE_STRING)
    string(SUBSTRING ${_C3D_PRIVATE_STRING} 1 -1 _C3D_PRIVATE_STRING)
    add_definitions( -DBI_PRIVATE_STRING="${_C3D_PRIVATE_STRING}")
  else()
    if(PROJECT_VERSION_MAJOR EQUAL 0)
      add_definitions( -DBI_PRIVATE_STRING="Local build")
    endif()
  endif()
  message(STATUS "Set project version to [${_C3D_FV}]")
  message(STATUS "Set private string to [${_C3D_PRIVATE_STRING}]")

  if(CMAKE_SIZEOF_VOID_P EQUAL 8)
    string(REPLACE "@pl@" "64" _C3D_FD ${_C3D_FD})
  else()
    string(REPLACE "@pl@" "32" _C3D_FD ${_C3D_FD})
  endif()
  if(MSVC)
    string(REGEX REPLACE "Visual Studio [0-9][0-9] " "VS" _C3D_PL_VER ${CMAKE_GENERATOR})
    string(REPLACE "@gen@" ${_C3D_PL_VER} _C3D_FD ${_C3D_FD})
  else()
    set(compiler_name "${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}")
    string(REPLACE "@gen@" ${compiler_name} _C3D_FD ${_C3D_FD})
  endif()

  if(MathTest_USING_UNICODE)
    string(REPLACE "@symb@" "Unicode" _C3D_FD ${_C3D_FD})
  else()
    string(REPLACE " @symb@" "" _C3D_FD ${_C3D_FD})
  endif()
  if(CMAKE_BUILD_TYPE)
    string(REPLACE "@bt@" ${CMAKE_BUILD_TYPE} _C3D_FD ${_C3D_FD})
  else()
    string(REPLACE " @bt@" "" _C3D_FD ${_C3D_FD})
  endif()

  set(_C3D_OPT " ")
  if(${is_math_library})
    if(MathTest_NO_ATOMIC)
      set(_C3D_OPT ${_C3D_OPT}\ [without-atomic] )
    endif()
  endif()
  if(${_C3D_OPT} STREQUAL " ")
    string(REPLACE "@opts@" "" _C3D_FD ${_C3D_FD})
  else()
    string(REPLACE "@opts@" ${_C3D_OPT} _C3D_FD ${_C3D_FD})
  endif()
  add_definitions( -DBI_FILEDESCRIPTION=${_C3D_FD} )
  message(STATUS "Set project description to [${_C3D_FD}]")

  if(NOT ${is_math_library})
    set(_C3D_TW "_T(\"Testing of geometrical kernel C3D [@qt@Visual C++ @bt@ (@pl@), @rev@]\")")
    if(MathTest_QT)
      string(REPLACE "@qt@" "Qt &" _C3D_TW ${_C3D_TW})
    else()
      string(REPLACE "@qt@" "" _C3D_TW ${_C3D_TW})
    endif()
    if(CMAKE_BUILD_TYPE)
      string(REPLACE "@bt@" ${CMAKE_BUILD_TYPE} _C3D_TW ${_C3D_TW})
    endif()
    if(CMAKE_CL_64)
      string(REPLACE "@pl@" "x64" _C3D_TW ${_C3D_TW})
    else()
      string(REPLACE "@pl@" "Win32" _C3D_TW ${_C3D_TW})
    endif()
    string(REPLACE "@rev@" ${PROJECT_VERSION_PATCH}${PROJECT_VERSION_TWEAK} _C3D_TW ${_C3D_TW})
    if(CMAKE_BUILD_TYPE)
      add_definitions( -D_TITLE_MAIN_WND_C3D_BLDNUM=${_C3D_TW} )
    endif()
    if(MathTest_L10N)
      add_definitions( -D__NATIVE_LANGUAGE__=Russian)
    endif()
  endif()
endmacro()
